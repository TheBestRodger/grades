APP_ENV=pilot
PUBLIC_BASE_URL=http://192.168.18.163:3000

POSTGRES_DB=grades_mgtu
POSTGRES_USER=grades_mgtu
POSTGRES_PASSWORD=change-me-in-.env

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
BOOTSTRAP_HR_USERNAME=
BOOTSTRAP_HR_PASSWORD=
AUTO_IMPORT_GRADES_DOCUMENTS=true

AI_MODE=token
AI_PROVIDER=openai_compatible
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-5-mini
OPENAI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=60

PROFILER_DATA_DIR=/app/backend/data
SERVE_FRONTEND_STATIC=false
DATABASE_URL=postgresql+psycopg://grades_mgtu:change-me-in-.env@postgres:5432/grades_mgtu
UVICORN_WORKERS=1
UVICORN_GRACEFUL_SHUTDOWN_SECONDS=30
