APP_PORT=8010
APP_ENV=pilot
PUBLIC_BASE_URL=http://192.168.18.163:8010

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
BOOTSTRAP_HR_USERNAME=
BOOTSTRAP_HR_PASSWORD=
AUTO_IMPORT_GRADES_DOCUMENTS=true

AI_MODE=token
AI_PROVIDER=openai_compatible
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-5-mini
OPENAI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=60

PROFILER_DATA_DIR=/app/backend/data
DATABASE_URL=sqlite:////app/backend/data/demo.sqlite
